{
  "name": "dfp-ide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:perf": "jest --testMatch='**/*.perf.test.ts'",
    "test:visual": "jest --testMatch='**/*.visual.test.ts'",
    "test:lighthouse": "jest --testMatch='**/lighthouse.test.ts' --runInBand --detectOpenHandles",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "lighthouse:ci": "node scripts/lighthouse-audit.js",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "playwright:install": "playwright install"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/uuid": "^10.0.0",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.13.1",
    "monaco-editor": "^0.55.1",
    "next": "^15.1.8",
    "openapi-types": "^12.1.3",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.28",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "^15.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-image-snapshot": "^6.5.1",
    "playwright": "^1.57.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
