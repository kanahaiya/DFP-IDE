import { test, expect } from '@playwright/test';

test.describe('CSV to JSON Converter', () => {
  test.beforeEach(async ({ page }) => {
    await page.goto('/csv-to-json');
    await page.waitForLoadState('networkidle');
  });

  test('page loads with correct title', async ({ page }) => {
    await expect(page).toHaveTitle(/CSV to JSON Converter/);
  });

  test('basic CSV conversion', async ({ page }) => {
    // Use the Load Sample button which reliably loads data
    const loadSampleBtn = page.locator('button:has-text("Load Sample")').first();
    await expect(loadSampleBtn).toBeVisible({ timeout: 3000 });
    await loadSampleBtn.click();
    
    // Wait for conversion (debounced 500ms + processing time)
    await page.waitForTimeout(1500);
    
    // Check output contains JSON (sample data should have user/product data)
    const outputEditor = page.locator('.ide-pane').last();
    const outputText = await outputEditor.textContent();
    
    // Sample CSV should contain some recognizable data
    expect(outputText.length).toBeGreaterThan(100); // Should have substantial output
    expect(outputText).toMatch(/\{|\[/); // Should contain JSON brackets
  });

  test('copy button works', async ({ page }) => {
    // Input CSV data first
    const csvInput = 'name,age\nJohn,30';
    
    // Use Monaco editor's API to set content
    await page.evaluate((csv) => {
      const editors = (window as any).monaco?.editor?.getModels();
      if (editors && editors.length > 0) {
        editors[0].setValue(csv);
      }
    }, csvInput);
    
    // Wait for conversion
    await page.waitForTimeout(1000);
    
    // Click copy button in output toolbar
    const copyBtn = page.locator('.ide-pane').last().locator('button[title*="Copy"]').first();
    await copyBtn.click();
    
    // Check for success message (MessageBox uses .message class)
    const successMessage = page.locator('.message', { hasText: 'Copied to clipboard' });
    await expect(successMessage).toBeVisible({ timeout: 3000 });
  });

  test('settings panel toggles', async ({ page }) => {
    // Open settings if not already open
    const settingsPanel = page.locator('.ide-sidebar');
    
    // Click parsing tab - be specific to avoid strict mode violation
    const parsingTab = page.locator('.sidebar-tab', { hasText: 'Parsing' }).first();
    if (await parsingTab.isVisible()) {
      await parsingTab.click();
      await page.waitForTimeout(300);
    }
    
    // Find the checkbox by its label
    const parseNumbersLabel = page.locator('label:has-text("Parse numbers")').first();
    const parseNumbersCheckbox = parseNumbersLabel.locator('input[type="checkbox"]');
    
    if (await parseNumbersCheckbox.isVisible()) {
      const wasChecked = await parseNumbersCheckbox.isChecked();
      await parseNumbersCheckbox.click();
      await page.waitForTimeout(200);
      // Checkbox should be toggled
      const isNowChecked = await parseNumbersCheckbox.isChecked();
      expect(isNowChecked).toBe(!wasChecked);
    }
  });

  test('delimiter auto-detection', async ({ page }) => {
    // Test semicolon-delimited CSV
    const csvInput = 'name;age;city\nJohn;30;NYC';
    
    // Use Monaco editor's API to set content
    await page.evaluate((csv) => {
      const editors = (window as any).monaco?.editor?.getModels();
      if (editors && editors.length > 0) {
        editors[0].setValue(csv);
      }
    }, csvInput);
    
    // Wait for conversion
    await page.waitForTimeout(1000);
    
    // Output should contain converted data
    const outputEditor = page.locator('.ide-pane').last();
    const outputText = await outputEditor.textContent();
    
    expect(outputText).toContain('John');
    expect(outputText).toContain('30');
  });

  test('download functionality', async ({ page }) => {
    // Load sample
    const loadSampleBtn = page.locator('button', { hasText: 'Load Sample' });
    if (await loadSampleBtn.isVisible()) {
      await loadSampleBtn.click();
    }
    
    // Wait for conversion
    await page.waitForTimeout(1000);
    
    // Set up download listener
    const downloadPromise = page.waitForEvent('download');
    
    // Click download button
    const downloadBtn = page.locator('button[title*="Download"], button:has-text("Download")').first();
    await downloadBtn.click();
    
    // Wait for download
    const download = await downloadPromise;
    
    // Check filename
    expect(download.suggestedFilename()).toMatch(/converted-.*\.json/);
  });

  test('help modal opens', async ({ page }) => {
    // Click help button
    const helpBtn = page.locator('button[title*="Help"], i.fa-question-circle').first();
    if (await helpBtn.isVisible()) {
      await helpBtn.click();
      await page.waitForTimeout(300);
      
      // Check modal appears (correct class is .help-modal)
      await expect(page.locator('.help-modal')).toBeVisible({ timeout: 2000 });
      await expect(page.locator('text=Getting Started')).toBeVisible();
    }
  });

  test('tab management', async ({ page }) => {
    // Click add tab button - use more specific selector
    const addTabBtn = page.locator('button.tab-add');
    await expect(addTabBtn).toBeVisible({ timeout: 2000 });
    
    // Get initial tab count
    const tabs = page.locator('.tab-item');
    const initialCount = await tabs.count();
    
    // Click to add new tab
    await addTabBtn.click();
    await page.waitForTimeout(300);
    
    // Check new tab appears
    const newCount = await tabs.count();
    expect(newCount).toBeGreaterThan(initialCount);
  });

  test('keyboard shortcuts', async ({ page }) => {
    // Input CSV
    const csvInput = 'name,age\nJohn,30';
    
    // Use Monaco editor's API to set content
    await page.evaluate((csv) => {
      const editors = (window as any).monaco?.editor?.getModels();
      if (editors && editors.length > 0) {
        editors[0].setValue(csv);
      }
    }, csvInput);
    
    // Wait for conversion
    await page.waitForTimeout(1000);
    
    // Test Ctrl+Enter (convert)
    await page.keyboard.press('Control+Enter');
    await page.waitForTimeout(500);
    
    // Test Ctrl+K (copy)
    await page.keyboard.press('Control+K');
    const successMessage = page.locator('.message', { hasText: 'Copied to clipboard' });
    await expect(successMessage).toBeVisible({ timeout: 2000 });
  });

  test('drag and drop file upload', async ({ page }) => {
    // Create a simple CSV file buffer
    const csvContent = 'name,age\nJohn,30\nJane,25';
    const buffer = Buffer.from(csvContent, 'utf-8');
    
    // Create data transfer
    const dataTransfer = await page.evaluateHandle((data) => {
      const dt = new DataTransfer();
      const file = new File([data], 'test.csv', { type: 'text/csv' });
      dt.items.add(file);
      return dt;
    }, csvContent);
    
    // Trigger drop event
    const inputPane = page.locator('.ide-pane').first();
    await inputPane.dispatchEvent('drop', { dataTransfer });
    
    // Wait for file to be processed
    await page.waitForTimeout(1000);
    
    // Check if data was loaded
    const outputText = await page.locator('.ide-pane').last().textContent();
    expect(outputText).toContain('John');
  });

  test('output format toggle', async ({ page }) => {
    // Input CSV
    const csvInput = 'name,age\nJohn,30\nJane,25';
    
    // Use Monaco editor's API to set content
    await page.evaluate((csv) => {
      const editors = (window as any).monaco?.editor?.getModels();
      if (editors && editors.length > 0) {
        editors[0].setValue(csv);
      }
    }, csvInput);
    
    // Wait for default conversion
    await page.waitForTimeout(1000);
    
    // Switch to Output tab in settings
    const outputTab = page.locator('.sidebar-tab', { hasText: 'Output' }).first();
    if (await outputTab.isVisible()) {
      await outputTab.click();
      await page.waitForTimeout(300);
      
      // Click on "Keyed Object" format
      const keyedBtn = page.locator('button:has-text("Keyed Object")');
      if (await keyedBtn.isVisible()) {
        await keyedBtn.click();
        
        // Wait for re-conversion
        await page.waitForTimeout(1000);
        
        // Output should be keyed format
        const output = await page.locator('.ide-pane').last().textContent();
        expect(output).toContain('John');
      }
    }
  });
});
